<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x64</PlatformTarget>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>MasterMiao</AssemblyName>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>build\</OutputPath>
    <ApplicationIcon Condition="Exists('build\MasterMiao.ico')">build\MasterMiao.ico</ApplicationIcon>
    <AppConfig>MasterMiao.exe.config</AppConfig>
    <SolidWorksInteropDir Condition="'$(SolidWorksInteropDir)' == ''">$(MSBuildThisFileDirectory)modules\HoleTools\dependencies\SolidWorks.Interop</SolidWorksInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Content Include="tools\RenderDrawingPdf.ps1" Link="RenderDrawingPdf.ps1" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="modules\HoleTools\scripts\Register-Addin.ps1;modules\HoleTools\scripts\Install-HoleTools.ps1">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Security" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="SolidWorks.Interop.sldworks"><HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath></Reference>
    <Reference Include="SolidWorks.Interop.swconst"><HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath></Reference>
    <Reference Include="SolidWorks.Interop.swpublished"><HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swpublished.dll</HintPath></Reference>
    <ProjectReference Include="modules\HoleTools\src\Blankedge.SWHoleTools.BatchExporter\Blankedge.SWHoleTools.BatchExporter.csproj" />
    <ProjectReference Include="modules\HoleTools\src\Blankedge.SWHoleTools\Blankedge.SWHoleTools.csproj" />
  </ItemGroup>
</Project>
