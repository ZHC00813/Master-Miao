<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <Prefer32Bit>false</Prefer32Bit>
    <OutputType>Exe</OutputType>
    <RootNamespace>Blankedge.SWHoleTools.Tests</RootNamespace>
    <AssemblyName>Blankedge.SWHoleTools.Tests</AssemblyName>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <AppConfig>App.config</AppConfig>
    <Deterministic>true</Deterministic>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SolidWorksInstallDir)' == '' and Exists('C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS')">
    <SolidWorksInstallDir>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS</SolidWorksInstallDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(SolidWorksInteropDir)' == '' and '$(SolidWorksInstallDir)' != ''">
    <SolidWorksInteropDir>$(SolidWorksInstallDir)\api\redist</SolidWorksInteropDir>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Blankedge.SWHoleTools\Blankedge.SWHoleTools.csproj" />
    <ProjectReference Include="..\..\src\Blankedge.SWHoleTools.BatchExporter\Blankedge.SWHoleTools.BatchExporter.csproj" />
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>$(SolidWorksInteropDir)\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
</Project>
